                 success = False
+                # Prompt + max_tokens over the context window is not transient: shrink max_tokens to the remaining room,
+                # or end this call with empty content (same as the context-limit path above) instead of crashing the run.
+                if "maximum context length" in str(exception):
+                    # vLLM only reports a lower bound on the prompt size, so halve max_tokens until it fits.
+                    current = (self.generation_kwargs | kwargs).get("max_tokens") or 8192
