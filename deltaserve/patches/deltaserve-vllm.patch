diff --git a/dserve-vllm/vllm/deltaserve/chat_sft.py b/dserve-vllm/vllm/deltaserve/chat_sft.py
new file mode 100644
index 0000000..d400a7a
--- /dev/null
+++ b/dserve-vllm/vllm/deltaserve/chat_sft.py
@@ -0,0 +1,112 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Chat SFT rows -> (token ids, loss spans), matching RSI-system's trainers.
+
+RSI-system (github.com/Jianshu-She/RSI-system) turns agent traces into chat
+JSONL (``{"messages": [...]}`` per line, ``rsi/finetune/DATA_FORMAT.md``) and
+trains on the assistant tokens only. The co-served trainer must see exactly the
+tokens and targets those offline trainers do, so this module ports their
+``encode`` functions:
+
+* ``"last"`` / ``"all"`` — ``rsi/finetune/train_lora.py`` (``--loss_on``,
+  ``--thinking``).
+* ``"ace"`` — ``benchmarks/ace/.../train_lora.py`` (thinking off; skips the
+  AppWorld few-shot demo dialogue; equals ``"all"`` + thinking off on
+  single-turn rows except for the prompt rendering of the first turn).
+
+A span ``(s, e)`` marks target token positions ``s .. e-1``: the loss is the
+next-token cross-entropy of predicting ``ids[j]`` from position ``j - 1`` for
+every ``j`` in a span.
+"""
+
+THINK_OFF = "<think>\n\n</think>\n\n"
+LOSS_ON = ("last", "all", "ace")
+
+
+def encode_chat(tok, messages: list[dict], loss_on: str = "all",
+                thinking: str = "off") -> tuple[list[int], list[tuple[int, int]]]:
+    """Return ``(ids, spans)``; ``spans`` is empty when the row has no usable
+    target (the caller drops it, as the offline trainers do)."""
+    if loss_on not in LOSS_ON:
+        raise ValueError(f"chat_loss_on must be one of {LOSS_ON}, got {loss_on!r}")
+    if thinking not in ("on", "off"):
+        raise ValueError(f"chat_thinking must be 'on' or 'off', got {thinking!r}")
+    if loss_on == "ace":
+        return _encode_ace(tok, messages)
+    tmpl = {} if thinking == "on" else {"enable_thinking": False}
+
+    if loss_on == "last":
+        # One target turn: prompt = the template's generation prompt for the
+        # history, exactly as at inference.
+        pre = _ids(tok.apply_chat_template(messages[:-1], tokenize=True,
+                                           add_generation_prompt=True, **tmpl))
+        full = _ids(tok.apply_chat_template(messages, tokenize=True,
+                                            add_generation_prompt=False, **tmpl))
+        if full[:len(pre)] == pre and len(full) > len(pre):
+            return full, [(len(pre), len(full))]
+        return full, []
+
+    # Every assistant turn, built turn by turn with the prefix the model was
+    # conditioned on when it generated that turn.
+    ids: list[int] = []
+    spans: list[tuple[int, int]] = []
+    nl = tok.encode("\n", add_special_tokens=False)
+    for m in messages:
+        role = m["role"]
+        if role not in ("system", "user", "assistant"):
+            raise ValueError(f"chat_loss_on='all' supports system/user/assistant, got {role}")
+        if role == "assistant":
+            ids += tok.encode("<|im_start|>assistant\n"
+                              + (THINK_OFF if thinking == "off" else ""),
+                              add_special_tokens=False)
+            body = tok.encode(m["content"] + "<|im_end|>", add_special_tokens=False)
+            spans.append((len(ids), len(ids) + len(body)))
+            ids += body + nl
+        else:
+            ids += tok.encode(f"<|im_start|>{role}\n{m['content']}<|im_end|>\n",
+                              add_special_tokens=False)
+    return ids, spans
+
+
+def _encode_ace(tok, messages: list[dict]):
+    """The ACE trainer's encode: the official template (thinking off) up to the
+    first assistant turn after the task start, then every later turn appended
+    by hand; loss on each assistant content + ``<|im_end|>``. AppWorld prompts
+    carry a few-shot demo dialogue — the task starts at the last user turn
+    saying "solve the actual task", and nothing before it is a target."""
+    start = max([i for i, m in enumerate(messages)
+                 if m["role"] == "user" and "solve the actual task" in m["content"]]
+                or [0])
+    first = next((i for i, m in enumerate(messages)
+                  if m["role"] == "assistant" and i > start), None)
+    if first is None:
+        return [], []
+    ids = tok.encode(tok.apply_chat_template(messages[:first], tokenize=False,
+                                             add_generation_prompt=True,
+                                             enable_thinking=False),
+                     add_special_tokens=False)
+    end = tok.convert_tokens_to_ids("<|im_end|>")
+    nl = tok.encode("\n", add_special_tokens=False)
+    spans: list[tuple[int, int]] = []
+    for i in range(first, len(messages)):
+        m = messages[i]
+        if m["role"] == "assistant":
+            if i != first:
+                ids += tok.encode("<|im_start|>assistant\n" + THINK_OFF,
+                                  add_special_tokens=False)
+            t = tok.encode(m["content"], add_special_tokens=False) + [end]
+            spans.append((len(ids), len(ids) + len(t)))
+            ids += t + nl
+        else:
+            ids += tok.encode(f"<|im_start|>{m['role']}\n{m['content']}<|im_end|>\n",
+                              add_special_tokens=False)
+    return ids, spans
+
+
+def _ids(x) -> list[int]:
+    """``apply_chat_template(tokenize=True)`` returns a list on transformers 4.x
+    and a BatchEncoding-like mapping on 5.x."""
+    if isinstance(x, dict) or hasattr(x, "keys"):
+        x = x["input_ids"]
+    return list(x)
diff --git a/tests/test_chat_sft.py b/tests/test_chat_sft.py
new file mode 100644
index 0000000..d052889
--- /dev/null
+++ b/tests/test_chat_sft.py
@@ -0,0 +1,207 @@
+"""Chat SFT (RSI-system data) gates — run with `python`, not pytest.
+
+1. ``deltaserve.chat_sft.encode_chat`` == the offline trainers' encode, token
+   for token, on real RSI-system rows (the reference functions below are copied
+   verbatim from rsi/finetune/train_lora.py and the ACE train_lora.py).
+2. ``head_backward(loss_spans=...)`` == an autograd reference with the loss on
+   the span tokens only (mean over target tokens); no spans == the old path.
+3. Coordinator: spans follow the runner's write order (request ids), not the
+   scheduler's order.
+4. ``FinetuningStore`` loads a .jsonl corpus into ids + spans.
+
+    python tests/test_chat_sft.py [--data-dir DIR] [--tokenizer PATH]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+import tempfile
+
+import torch
+import torch.nn.functional as F
+from transformers import AutoTokenizer
+
+from vllm.deltaserve.bwd_services.common.head import head_backward
+from vllm.deltaserve.bwd_services.common.ops import rmsnorm
+from vllm.deltaserve.chat_sft import encode_chat
+from vllm.deltaserve.coordinator import FinetuneCoordinator
+from vllm.deltaserve.finetuning_store import FinetuningStore
+
+PASS = FAIL = 0
+
+
+def cond(name, ok, detail=""):
+    global PASS, FAIL
+    PASS += bool(ok)
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}{(' — ' + detail) if detail else ''}")
+
+
+# ── reference encoders (verbatim from the offline trainers) ──────────────────
+THINK_OFF = "<think>\n\n</think>\n\n"
+
+
+def ref_rsi(tok, msgs, loss_on, thinking):          # rsi/finetune/train_lora.py
+    TMPL = {} if thinking == "on" else {"enable_thinking": False}
+
+    def render(m, gen=False):
+        out = tok.apply_chat_template(m, tokenize=True, add_generation_prompt=gen, **TMPL)
+        return list(out["input_ids"]) if hasattr(out, "keys") else list(out)
+
+    if loss_on == "last":
+        pre, full = render(msgs[:-1], gen=True), render(msgs)
+        return (full, [(len(pre), len(full))]) if full[:len(pre)] == pre and len(full) > len(pre) else (full, [])
+    ids, spans = [], []
+    for m in msgs:
+        if m["role"] == "assistant":
+            ids += tok.encode("<|im_start|>assistant\n" + (THINK_OFF if thinking == "off" else ""), add_special_tokens=False)
+            body = tok.encode(m["content"] + "<|im_end|>", add_special_tokens=False)
+            spans.append((len(ids), len(ids) + len(body)))
+            ids += body + tok.encode("\n", add_special_tokens=False)
+        else:
+            ids += tok.encode(f"<|im_start|>{m['role']}\n{m['content']}<|im_end|>\n", add_special_tokens=False)
+    return ids, spans
+
+
+def ref_ace(tok, messages):                          # benchmarks/ace/.../train_lora.py
+    END = tok.convert_tokens_to_ids("<|im_end|>")
+    start = max([i for i, m in enumerate(messages) if m["role"] == "user" and "solve the actual task" in m["content"]] or [0])
+    first = next(i for i, m in enumerate(messages) if m["role"] == "assistant" and i > start)
+    ids = tok.encode(tok.apply_chat_template(messages[:first], tokenize=False, add_generation_prompt=True,
+                                             enable_thinking=False), add_special_tokens=False)
+    labels = [-100] * len(ids)
+    nl = tok.encode("\n", add_special_tokens=False)
+    for i in range(first, len(messages)):
+        m = messages[i]
+        if m["role"] == "assistant":
+            if i != first:
+                p = tok.encode("<|im_start|>assistant\n" + THINK_OFF, add_special_tokens=False)
+                ids, labels = ids + p, labels + [-100] * len(p)
+            t = tok.encode(m["content"], add_special_tokens=False) + [END]
+            ids, labels = ids + t + nl, labels + t + [-100] * len(nl)
+        else:
+            p = tok.encode(f"<|im_start|>{m['role']}\n{m['content']}<|im_end|>\n", add_special_tokens=False)
+            ids, labels = ids + p, labels + [-100] * len(p)
+    return ids, labels
+
+
+def spans_to_labels(ids, spans):
+    lab = [-100] * len(ids)
+    for s, e in spans:
+        lab[s:e] = ids[s:e]
+    return lab
+
+
+def encoder_parity(tok, data_dir, n_rows):
+    print("encode_chat == offline trainers")
+    for name in ("formula", "finer", "appworld"):
+        path = os.path.join(data_dir, f"{name}.jsonl")
+        if not os.path.exists(path):
+            print(f"  (skip {name}: {path} missing)")
+            continue
+        rows = [json.loads(ln)["messages"] for ln in open(path) if ln.strip()][:n_rows]
+        modes = [("ace", "off"), ("all", "off")] + ([("last", "off")] if name != "appworld" else [])
+        for loss_on, thinking in modes:
+            bad = 0
+            for msgs in rows:
+                got_ids, got_sp = encode_chat(tok, msgs, loss_on, thinking)
+                if loss_on == "ace":
+                    rid, rlab = ref_ace(tok, msgs)
+                    ok = got_ids == rid and spans_to_labels(got_ids, got_sp) == rlab
+                else:
+                    rid, rsp = ref_rsi(tok, msgs, loss_on, thinking)
+                    ok = got_ids == rid and [tuple(x) for x in got_sp] == [tuple(x) for x in rsp]
+                bad += not ok
+            cond(f"{name} loss_on={loss_on}: {len(rows)} rows identical", bad == 0, f"{bad} mismatches")
+
+
+def head_parity():
+    print("head_backward with loss spans")
+    torch.manual_seed(0)
+    D, vocab = 32, 500
+    seq_lens = [12, 7, 9]
+    b_start = [0, 12, 19]
+    n = sum(seq_lens)
+    final_in = torch.randn(n, D, dtype=torch.float32)
+    lm_w = torch.randn(vocab, D) * 0.1
+    norm_w = torch.rand(D) + 0.5
+    ids = torch.randint(0, vocab, (n,))
+    spans = [[(4, 9), (10, 12)], None, [(0, 3)]]      # (0, 3): position 0 is skipped
+
+    # reference: autograd CE over the selected predicting rows, mean over them
+    x = final_in.clone().requires_grad_(True)
+    h = rmsnorm(x, norm_w, 1e-6).float()
+    rows, tg = [], []
+    for k, (st, ln) in enumerate(zip(b_start, seq_lens)):
+        sel = range(1, ln) if spans[k] is None else [j for s, e in spans[k] for j in range(max(s, 1), e)]
+        for j in sel:
+            rows.append(st + j - 1)
+            tg.append(int(ids[st + j]))
+    logits = h[rows] @ lm_w.t()
+    ref_loss = F.cross_entropy(logits, torch.tensor(tg), reduction="mean")
+    ref_loss.backward()
+    loss, n_valid, g = head_backward(final_in, lm_w, norm_w, 1e-6, ids, seq_lens, b_start,
+                                     vocab, loss_spans=spans)
+    cond("n_valid = number of target tokens", n_valid == len(rows), f"{n_valid} vs {len(rows)}")
+    cond("loss matches", abs(loss - ref_loss.item()) < 1e-5, f"{loss:.6f} vs {ref_loss.item():.6f}")
+    err = (g - x.grad).abs().max().item() / (x.grad.abs().max().item() + 1e-12)
+    cond("grad_final_in matches", err < 1e-5, f"rel err {err:.1e}")
+    l0, n0, g0 = head_backward(final_in, lm_w, norm_w, 1e-6, ids, seq_lens, b_start, vocab)
+    l1, n1, g1 = head_backward(final_in, lm_w, norm_w, 1e-6, ids, seq_lens, b_start, vocab,
+                               loss_spans=[None, None, None])
+    cond("all-None spans == no spans (old path)", l0 == l1 and n0 == n1 and torch.equal(g0, g1))
+
+
+def coordinator_order():
+    print("coordinator: spans follow the runner's write order")
+    c = FinetuneCoordinator(capacity=1024)
+    sp_a, sp_b, sp_c = [(3, 5)], [(1, 4), (6, 8)], None
+    # scheduler order a, b, c …
+    c.reserve(30, samples=["A", "B", "C"], req_spans={"ft_a": sp_a, "ft_b": sp_b, "ft_c": sp_c})
+    # … but the runner wrote b, c, a
+    c.record_capture(30, [8, 12, 10], ["ft_b", "ft_c", "ft_a"])
+    got = c._loss_spans()
+    cond("spans in write order", got == [[[1, 4], [6, 8]], None, [[3, 5]]], str(got))
+    c2 = FinetuneCoordinator(capacity=1024)
+    c2.reserve(10, samples=["X"], req_spans={"x": None})
+    c2.record_capture(10, [10], ["x"])
+    cond("plain-text samples → None (loss on every token)", c2._loss_spans() is None)
+    c3 = FinetuneCoordinator(capacity=1024)
+    c3.reserve(10, samples=["X"], req_spans={"x": [(1, 2)]})
+    c3.record_capture(10, [10])                     # no ids (old runner) → no masks
+    cond("missing ids degrade to None, never misalign", c3._loss_spans() is None)
+
+
+def store_load(tok):
+    print("FinetuningStore loads .jsonl")
+    rows = [{"messages": [{"role": "user", "content": "What is 2+2?"},
+                          {"role": "assistant", "content": "4"}]},
+            {"messages": [{"role": "user", "content": "no answer"}]}]
+    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as f:
+        f.write("\n".join(json.dumps(r) for r in rows) + "\n")
+    st = FinetuningStore(f.name, tokenize=lambda t: tok(t)["input_ids"], max_saved_finetuning_tokens=4096,
+                         chat_loss_on="ace", tokenizer=tok)
+    n = st.load()
+    os.unlink(f.name)
+    s0 = st.samples[0] if st.samples else None
+    cond("1 row loaded, the target-less row skipped", n == 1)
+    ok = s0 is not None and tok.decode(s0.prompt_ids[s0.loss_spans[0][0]:s0.loss_spans[0][1]]) == "4<|im_end|>"
+    cond("the span decodes to the assistant answer + <|im_end|>", ok)
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--data-dir", default="/mnt/weka/home/jianshu.she/RSI-system/benchmark/ACE/sft/data_v1")
+    ap.add_argument("--tokenizer", default="/mnt/weka/home/jianshu.she/scratch/Qwen3-32B")
+    ap.add_argument("--rows", type=int, default=60)
+    a = ap.parse_args()
+    tok = AutoTokenizer.from_pretrained(a.tokenizer)
+    encoder_parity(tok, a.data_dir, a.rows)
+    head_parity()
+    coordinator_order()
+    store_load(tok)
+    print(f"\n{PASS} passed, {FAIL} failed")
+    sys.exit(1 if FAIL else 0)
diff --git a/tests/test_rope_yarn.py b/tests/test_rope_yarn.py
new file mode 100644
index 0000000..1dc7994
--- /dev/null
+++ b/tests/test_rope_yarn.py
@@ -0,0 +1,115 @@
+"""Backward RoPE with YaRN == vLLM's YaRNScalingRotaryEmbedding (run with `python`).
+
+RSI-system serves Qwen3-32B with YaRN x4 (131072 ctx). YaRN changes the rotary
+frequencies at EVERY position and scales cos/sin by mscale, so the backward's
+RoPE remat must reproduce it exactly or the LoRA gradients are wrong.
+
+    python tests/test_rope_yarn.py [--yarn-config DIR]
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+
+import torch
+from transformers import AutoConfig
+
+from vllm.deltaserve.bwd_services.common.ops import apply_rope, rope_backward, rope_cos_sin
+from vllm.deltaserve.ft_meta import rope_scaling_of
+from vllm.model_executor.layers.rotary_embedding.yarn_scaling_rope import (
+    YaRNScalingRotaryEmbedding,
+)
+
+PASS = FAIL = 0
+
+
+def cond(name, ok, detail=""):
+    global PASS, FAIL
+    PASS += bool(ok)
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}{(' — ' + detail) if detail else ''}")
+
+
+def _vllm_yarn_cache(hd, orig, theta, factor):
+    """vLLM's own YaRN cos/sin cache, via its methods on a bare instance (the
+    CustomOp constructor needs a device-bearing vLLM config; the math does not)."""
+    from vllm.model_executor.layers.rotary_embedding.common import yarn_get_mscale
+    ref = object.__new__(YaRNScalingRotaryEmbedding)
+    ref.head_size = ref.rotary_dim = hd
+    ref.max_position_embeddings = orig
+    ref.base = theta
+    ref.scaling_factor = factor
+    ref.extrapolation_factor = ref.attn_factor = 1
+    ref.beta_fast, ref.beta_slow, ref.truncate = 32, 1, True
+    ref.mscale = float(yarn_get_mscale(factor))
+    return ref._compute_cos_sin_cache()
+
+
+def against_vllm(theta=1e6, hd=128, factor=4.0, orig=32768):
+    print(f"cos/sin + rotation vs vLLM YaRN (theta={theta:g}, head_dim={hd}, x{factor:g})")
+    cache_all = _vllm_yarn_cache(hd, orig, theta, factor)
+    sc = {"rope_type": "yarn", "factor": factor, "original_max_position_embeddings": orig}
+    pos = torch.tensor([0, 1, 7, 513, 4095, 32767, 40000, 131071])
+    cache = cache_all[pos].float()
+    cos_r, sin_r = cache[:, : hd // 2], cache[:, hd // 2:]
+    cos, sin = rope_cos_sin(pos, hd, theta, sc)
+    err = max((cos - cos_r).abs().max().item(), (sin - sin_r).abs().max().item())
+    cond("cos/sin == vLLM YaRN cache (incl. mscale)", err < 1e-5, f"max abs err {err:.1e}")
+    plain_c, _ = rope_cos_sin(pos, hd, theta)
+    cond("YaRN differs from plain RoPE (so the fix matters)",
+         (plain_c - cos).abs().max().item() > 1e-2)
+
+    torch.manual_seed(0)
+    n, H = len(pos), 4
+    q = torch.randn(n, H, hd)
+    # NeoX rotation with vLLM's cache, written out independently
+    c, s_ = cos_r[:, None, :], sin_r[:, None, :]
+    x1, x2 = q[..., : hd // 2], q[..., hd // 2:]
+    q_r = torch.cat([x1 * c - x2 * s_, x2 * c + x1 * s_], dim=-1)
+    q_o = apply_rope(q, cos, sin)
+    err = (q_o - q_r).abs().max().item() / q_r.abs().max().item()
+    cond("apply_rope == NeoX rotation with vLLM's cache", err < 1e-5, f"rel err {err:.1e}")
+    g = torch.randn(n, H, hd)
+    lhs = (g * apply_rope(q, cos, sin)).sum()
+    rhs = (rope_backward(g, cos, sin) * q).sum()
+    cond("rope_backward is the adjoint under mscale", abs(lhs - rhs) / abs(lhs) < 1e-5)
+
+
+def config_parsing(yarn_dir):
+    print("rope_scaling_of")
+    class C:  # transformers 5 / vLLM-normalized form
+        rope_parameters = {"rope_theta": 1e6, "rope_type": "yarn", "factor": 4.0,
+                           "original_max_position_embeddings": 32768}
+    got = rope_scaling_of(C())
+    cond("rope_parameters (yarn) parsed", got == {"rope_type": "yarn", "factor": 4.0,
+                                                  "original_max_position_embeddings": 32768}, str(got))
+    class P:
+        rope_parameters = {"rope_theta": 1e6, "rope_type": "default"}
+    cond("plain RoPE → None", rope_scaling_of(P()) is None)
+    class L:
+        rope_parameters = {"rope_theta": 5e5, "rope_type": "llama3", "factor": 8.0}
+    try:
+        rope_scaling_of(L())
+        cond("unsupported scaling raises", False)
+    except NotImplementedError:
+        cond("unsupported scaling raises", True)
+    if yarn_dir:
+        try:
+            got = rope_scaling_of(AutoConfig.from_pretrained(yarn_dir))
+            cond(f"RSI-system YaRN model config parsed ({yarn_dir.rsplit('/', 1)[-1]})",
+                 got is not None and got["factor"] == 4.0
+                 and got["original_max_position_embeddings"] == 32768, str(got))
+        except OSError as e:
+            print(f"  (skip real config: {e})")
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--yarn-config",
+                    default="/mnt/weka/home/jianshu.she/RSI-system/benchmark/ACE/models/Qwen3-32B-yarn131k")
+    a = ap.parse_args()
+    against_vllm()
+    config_parsing(a.yarn_config)
+    print(f"\n{PASS} passed, {FAIL} failed")
+    sys.exit(1 if FAIL else 0)
diff --git a/tests/test_adapter_export.py b/tests/test_adapter_export.py
new file mode 100644
index 0000000..661c7e9
--- /dev/null
+++ b/tests/test_adapter_export.py
@@ -0,0 +1,113 @@
+"""FT adapter export (PEFT dir) gates — run with `python`, not pytest. CPU/gloo.
+
+1. TP=1: ``export_adapter`` writes the fp32 masters under their original PEFT
+   names and full shapes, plus an adapter_config.json, and refreshes latest/.
+2. TP=2: after identical training, the shards gathered + merged by rank 0
+   equal the TP=1 export (q/k/v B row shards, o A column shards).
+3. ``adapter_save_every`` exports from inside process_backward.
+
+    python tests/test_adapter_export.py
+"""
+
+import json
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+from safetensors.torch import load_file
+
+TESTS = str(Path(__file__).resolve().parent)
+sys.path.insert(0, TESTS)
+import test_tp_trainer_graph_nccl as T  # noqa: E402
+
+T.GEOM["qwen3"].update(hidden=48, Hq=8, Hkv=4, inter=128)
+PORT = 29741
+PASS = FAIL = 0
+
+
+def cond(name, ok, detail=""):
+    global PASS, FAIL
+    PASS += bool(ok)
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}{(' — ' + detail) if detail else ''}")
+
+
+def train(svc, full, steps=3):
+    starts = [0, T.SEQ_LENS[0]]
+    for _ in range(steps):
+        acts = T.remat_activations(svc, full["embed"], full["ids"], T.SEQ_LENS, starts)
+        svc.process_backward(acts, T.SEQ_LENS, sum(T.SEQ_LENS), epoch=0)
+
+
+def worker(rank, path, out):
+    full = torch.load(path)
+    meta = T.make_meta("qwen3", tp_size=2, tp_rank=rank, port=PORT, graph=False)
+    svc = T.make_service("qwen3", T.shard_base(full["base"], rank, 2, "qwen3"),
+                         full["ft"], meta, torch.device("cpu"))
+    svc._src_adapter = None
+    train(svc, full)
+    svc.export_adapter(os.path.join(out, "tp2"))
+    dist.destroy_process_group()
+
+
+def main():
+    full = T.build_full("qwen3", seed=11)
+    with tempfile.TemporaryDirectory(prefix="adapter_export_") as tmp:
+        # source adapter_config.json the export should copy
+        src = os.path.join(tmp, "src")
+        os.makedirs(src)
+        json.dump({"peft_type": "LORA", "r": 4, "lora_alpha": 8,
+                   "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"]},
+                  open(os.path.join(src, "adapter_config.json"), "w"))
+
+        print("TP=1 export")
+        meta = T.make_meta("qwen3", tp_size=1, tp_rank=0, port=0, graph=False)
+        meta.update(adapter_save_dir=os.path.join(tmp, "periodic"), adapter_save_every=2,
+                    finetuning_lora_path=src)
+        ref = T.make_service("qwen3", full["base"], full["ft"], meta, torch.device("cpu"))
+        train(ref, full)
+        ref.export_adapter(os.path.join(tmp, "tp1"))
+        sd = load_file(os.path.join(tmp, "tp1", "adapter_model.safetensors"))
+        cond("same tensor names as the source adapter", set(sd) == set(full["ft"]))
+        cond("full (unsharded) shapes", all(sd[k].shape == full["ft"][k].shape for k in sd))
+        masters = {ref._lora_keys[k]: ref.lora[k[0]][k[1]][k[2]].detach() for k in ref._lora_keys}
+        cond("values == fp32 masters", all(torch.equal(sd[k], masters[k]) for k in sd))
+        cond("training moved the weights",
+             any(not torch.equal(sd[k], full["ft"][k].float()) for k in sd))
+        cfg = json.load(open(os.path.join(tmp, "tp1", "adapter_config.json")))
+        cond("adapter_config copied (r, alpha, targets) + inference_mode",
+             cfg["r"] == 4 and cfg["lora_alpha"] == 8 and cfg["inference_mode"] is True)
+        cond("latest/ refreshed", os.path.exists(os.path.join(tmp, "latest", "adapter_model.safetensors")))
+        cond("adapter_save_every=2 exported cycle2/ during training",
+             os.path.exists(os.path.join(tmp, "periodic", "cycle2", "adapter_model.safetensors")))
+
+        print("TP=2 export (gloo) == TP=1")
+        path = os.path.join(tmp, "full.pt")
+        torch.save(full, path)
+        ctx = mp.get_context("spawn")
+        procs = [ctx.Process(target=worker, args=(r, path, tmp)) for r in range(2)]
+        for p in procs:
+            p.start()
+        for p in procs:
+            p.join(900)
+        cond("both ranks exited cleanly", all(p.exitcode == 0 for p in procs),
+             str([p.exitcode for p in procs]))
+        f2 = os.path.join(tmp, "tp2", "adapter_model.safetensors")
+        if os.path.exists(f2):
+            sd2 = load_file(f2)
+            err = max((sd2[k] - sd[k]).abs().max().item() / (sd[k].abs().max().item() + 1e-12)
+                      for k in sd)
+            cond("merged TP=2 adapter == TP=1 adapter", set(sd2) == set(sd) and err < 1e-4,
+                 f"max rel err {err:.1e}")
+        else:
+            cond("rank 0 wrote the TP=2 adapter", False)
+    print(f"\n{PASS} passed, {FAIL} failed")
+    sys.exit(1 if FAIL else 0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_ft_ingest.py b/tests/test_ft_ingest.py
new file mode 100644
index 0000000..f046330
--- /dev/null
+++ b/tests/test_ft_ingest.py
@@ -0,0 +1,71 @@
+"""Runtime FT ingest (POST /ft/ingest → FinetuningStore.add_rows) — run with `python`.
+
+1. A server started with no corpus: admission may already have walked the epoch
+   counter forward; the first ingest restarts it at 0 and the rows are selectable.
+2. Chat rows get loss spans; plain-text rows don't; target-less / too-long rows skip.
+3. Ingest after training has started appends to the CURRENT epoch's pool
+   without resetting the epoch or the trained marks.
+
+    python tests/test_ft_ingest.py [--tokenizer PATH]
+"""
+
+import argparse
+import sys
+
+from transformers import AutoTokenizer
+
+from vllm.deltaserve.finetuning_store import FinetuningStore
+
+PASS = FAIL = 0
+
+
+def cond(name, ok, detail=""):
+    global PASS, FAIL
+    PASS += bool(ok)
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}{(' — ' + detail) if detail else ''}")
+
+
+def chat(q, a):
+    return {"messages": [{"role": "user", "content": q}, {"role": "assistant", "content": a}]}
+
+
+def main(tok):
+    st = FinetuningStore(None, tokenize=lambda t: tok(t)["input_ids"], total_epochs=2,
+                         max_saved_finetuning_tokens=64, chat_loss_on="ace", tokenizer=tok)
+    st.load()
+    while st.advance_epoch():      # what an admission loop on an empty store does
+        pass
+    cond("empty store walked the epochs", st.current_epoch == 2)
+    r = st.add_rows([chat("2+2?", "4"), chat("3+3?", "6"), {"text": "plain text row"},
+                     {"messages": [{"role": "user", "content": "no answer"}]},
+                     chat("long " * 80, "x")])
+    cond("3 added, 1 without target, 1 too long",
+         r["added"] == 3 and r["skipped_no_target"] == 1 and r["skipped_too_long"] == 1, str(r))
+    cond("epoch restarted at 0 (nothing trained yet)", st.current_epoch == 0)
+    cond("ingested rows are selectable", st.has_next() and st.pop_next() is not None)
+    cond("chat rows carry spans, text rows don't",
+         st.samples[0].loss_spans and st.samples[2].loss_spans is None)
+
+    # train two samples, then ingest more: same epoch, marks kept
+    a = st.pop_next()
+    b = st.pop_next(exclude=[a])
+    st.claim([a, b])
+    st.commit_claimed([a, b])
+    ep = st.current_epoch
+    st.add_rows([chat("5+5?", "10")])
+    cond("post-training ingest keeps the epoch", st.current_epoch == ep)
+    cond("trained marks kept", st.trained[st.id2idx[a.request_id]] and st.trained[st.id2idx[b.request_id]])
+    left = []
+    while (s := st.pop_next(exclude=left)) is not None:
+        left.append(s)
+    cond("new row joins the current pool (2 untrained left)", len(left) == 2, str(len(left)))
+    print(f"\n{PASS} passed, {FAIL} failed")
+    return FAIL == 0
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--tokenizer", default="/mnt/weka/home/jianshu.she/scratch/Qwen3-32B")
+    a = ap.parse_args()
+    sys.exit(0 if main(AutoTokenizer.from_pretrained(a.tokenizer)) else 1)
diff --git a/tests/test_long_context_backward.py b/tests/test_long_context_backward.py
new file mode 100644
index 0000000..52e1eaf
--- /dev/null
+++ b/tests/test_long_context_backward.py
@@ -0,0 +1,157 @@
+"""Long-context backward gates (run with `python`, not pytest).
+
+1. Query-chunked attention forward/backward == the dense path (fp32).
+2. Streaming LM head (online logsumexp) == the dense head (loss + grad).
+3. Coordinator ``batch_tokens``: an empty buffer takes one long sample, a
+   non-empty one only tops up to the batch size.
+4. (GPU) one Qwen3-32B-TP4-shaped layer's attention backward at 16K tokens:
+   peak memory and time, on the chunked path.
+
+    python tests/test_long_context_backward.py
+"""
+
+from __future__ import annotations
+
+import sys
+import time
+
+import torch
+
+from vllm.deltaserve.bwd_services.common import attention as A
+from vllm.deltaserve.bwd_services.common import head as Hd
+from vllm.deltaserve.coordinator import FinetuneCoordinator
+
+DEV = "cuda" if torch.cuda.is_available() else "cpu"
+PASS = FAIL = 0
+
+
+def check(name, got, ref, tol):
+    global PASS, FAIL
+    err = (got.float() - ref.float()).abs().max().item()
+    scale = ref.float().abs().max().item() + 1e-12
+    ok = err / scale <= tol
+    PASS += ok
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}: rel max err {err / scale:.2e}")
+
+
+def cond(name, ok):
+    global PASS, FAIL
+    PASS += bool(ok)
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}")
+
+
+def attn_parity():
+    print("attention: chunked vs dense")
+    torch.manual_seed(0)
+    Hq, Hkv, D = 8, 2, 64
+    seq_lens = [37, 300, 1000, 17]
+    b_start = [sum(seq_lens[:i]) for i in range(len(seq_lens))]
+    n = sum(seq_lens)
+    dims = (Hq, Hkv, D, Hkv * D)
+    qh = torch.randn(n, Hq, D, device=DEV)
+    kh = torch.randn(n, Hkv, D, device=DEV)
+    vh = torch.randn(n, Hkv, D, device=DEV)
+    g = torch.randn(n, Hq, D, device=DEV)
+    big = A.SCORES_BYTES
+    try:
+        A.SCORES_BYTES = 1 << 62                       # dense everywhere
+        ref_ctx = A.attn_forward_core(qh, kh, vh, seq_lens, b_start, dims,
+                                      torch.float32)
+        ref = A.attn_backward_core(qh, kh, vh, g, seq_lens, b_start, dims)
+        for budget in (Hq * 1000 * 4 * 100, Hq * 1000 * 4 * 16, 4096):
+            A.SCORES_BYTES = budget                    # chunk the long ones
+            cs = [A._q_chunk(Hq, ln) for ln in seq_lens]
+            ctx = A.attn_forward_core(qh, kh, vh, seq_lens, b_start, dims,
+                                      torch.float32)
+            got = A.attn_backward_core(qh, kh, vh, g, seq_lens, b_start, dims)
+            cond(f"budget={budget} chunks={cs} takes the chunked path",
+                 any(c < ln for c, ln in zip(cs, seq_lens)))
+            check(f"budget={budget} ctx", ctx, ref_ctx, 1e-5)
+            for nm, a, b in zip(("dq", "dk", "dv"), got, ref):
+                check(f"budget={budget} {nm}", a, b, 1e-5)
+    finally:
+        A.SCORES_BYTES = big
+
+
+def head_parity():
+    print("head: streaming vs dense")
+    torch.manual_seed(1)
+    D, vocab, vpad = 64, 40000, 40064               # > 2 vocab chunks + padding
+    seq_lens = [50, 3, 1, 200]
+    b_start = [sum(seq_lens[:i]) for i in range(len(seq_lens))]
+    n = sum(seq_lens)
+    final_in = torch.randn(n, D, device=DEV, dtype=torch.bfloat16)
+    lm_w = (torch.randn(vpad, D, device=DEV) * 0.05).to(torch.bfloat16)
+    norm_w = torch.rand(D, device=DEV) + 0.5
+    ids = torch.randint(0, vocab, (n,), device=DEV)
+    ids[5] = vocab - 1                               # target in the last chunk
+    ids[6] = 0
+    big = Hd.LOGITS_BYTES
+    try:
+        Hd.LOGITS_BYTES = 1 << 62
+        l_ref, nv_ref, g_ref = Hd.head_backward(final_in, lm_w, norm_w, 1e-6, ids,
+                                                seq_lens, b_start, vocab)
+        Hd.LOGITS_BYTES = 0
+        l, nv, g = Hd.head_backward(final_in, lm_w, norm_w, 1e-6, ids,
+                                    seq_lens, b_start, vocab)
+    finally:
+        Hd.LOGITS_BYTES = big
+    cond(f"n_valid {nv} == {nv_ref}", nv == nv_ref)
+    cond(f"loss {l:.6f} == {l_ref:.6f}", abs(l - l_ref) <= 1e-5 * abs(l_ref))
+    check("grad_final_in", g, g_ref, 1e-5)
+
+
+def coordinator_batching():
+    print("coordinator: batch_tokens")
+    c = FinetuneCoordinator(capacity=16384)
+    cond("default batch_tokens == capacity", c.batch_tokens == 16384)
+    c.batch_tokens = 512
+    cond("empty buffer offers the full capacity", c.space_remaining() == 16384)
+    c.fill_count = 300
+    cond("non-empty buffer tops up to batch_tokens", c.space_remaining() == 212)
+    c.fill_count = 10000
+    cond("a long sample alone leaves no space", c.space_remaining() == 0)
+    c.fill_count, c.reserved_fill = 0, 200
+    cond("reservations count as used", c.space_remaining() == 312)
+    c2 = FinetuneCoordinator(capacity=512)
+    c2.fill_count = 100
+    cond("batch_tokens == capacity keeps the original arithmetic",
+         c2.space_remaining() == 412)
+
+
+def long_attention_cost():
+    if DEV != "cuda":
+        print("long attention: skipped (no GPU)")
+        return
+    print("long attention: Qwen3-32B TP=4 shard (Hq=16, Hkv=2, Hd=128), L=16384")
+    torch.manual_seed(2)
+    Hq, Hkv, D, L = 16, 2, 128, 16384
+    dims = (Hq, Hkv, D, Hkv * D)
+    qh = torch.randn(L, Hq, D, device=DEV, dtype=torch.bfloat16)
+    kh = torch.randn(L, Hkv, D, device=DEV, dtype=torch.bfloat16)
+    vh = torch.randn(L, Hkv, D, device=DEV, dtype=torch.bfloat16)
+    g = torch.randn(L, Hq, D, device=DEV, dtype=torch.bfloat16)
+    torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+    base = torch.cuda.memory_allocated()
+    t0 = time.perf_counter()
+    out = A.attn_backward_core(qh, kh, vh, g, [L], [0], dims, cdt=torch.bfloat16)
+    torch.cuda.synchronize()
+    dt = time.perf_counter() - t0
+    peak = (torch.cuda.max_memory_allocated() - base) / 2**30
+    dense = 4 * Hq * L * L * 4 / 2**30
+    print(f"  chunk={A._q_chunk(Hq, L)} rows, {dt * 1e3:.0f} ms/layer, "
+          f"peak +{peak:.2f} GiB (dense path would need ~{dense:.0f} GiB)")
+    cond("finite grads", all(torch.isfinite(t).all().item() for t in out))
+    cond("peak memory < 4 GiB", peak < 4)
+
+
+if __name__ == "__main__":
+    attn_parity()
+    head_parity()
+    coordinator_batching()
+    long_attention_cost()
+    print(f"\n{PASS} passed, {FAIL} failed")
+    sys.exit(1 if FAIL else 0)
diff --git a/tests/test_tp_bucket_optional_lora.py b/tests/test_tp_bucket_optional_lora.py
new file mode 100644
index 0000000..262a8af
--- /dev/null
+++ b/tests/test_tp_bucket_optional_lora.py
@@ -0,0 +1,80 @@
+"""QKV-only LoRA: four-rank bucketed AdamW must match a TP=1 reference.
+
+CPU/gloo test through the real Qwen3 trainer, including clipping and multiple
+optimizer steps. Run with dserve-vllm/.venv/bin/python from the repository root.
+"""
+
+import sys
+import tempfile
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+
+TESTS = str(Path(__file__).resolve().parent)
+sys.path.insert(0, TESTS)
+import test_tp_trainer_graph_nccl as T  # noqa: E402
+sys.path.insert(0, TESTS)
+
+# Four KV heads allow four shards; Q width 64 differs from residual width 48.
+T.GEOM["qwen3"].update(hidden=48, Hq=8, Hkv=4, inter=128)
+PORT = 29724
+
+
+def train(svc, full):
+    losses = []
+    starts = [0, T.SEQ_LENS[0]]
+    for _ in range(T.STEPS):
+        acts = T.remat_activations(svc, full["embed"], full["ids"], T.SEQ_LENS, starts)
+        loss, _ = svc.process_backward(acts, T.SEQ_LENS, sum(T.SEQ_LENS), epoch=0)
+        losses.append(loss)
+    masters = {f"L{i}.{proj}{ab}": param.detach().clone()
+               for i, layer in svc.lora.items() for proj, factors in layer.items()
+               for ab, param in factors.items()}
+    return {"losses": torch.tensor(losses), "masters": masters}
+
+
+def worker(rank, path, out):
+    full = torch.load(path)
+    svc = T.make_service("qwen3", T.shard_base(full["base"], rank, 4, "qwen3"),
+                         full["ft"], T.make_meta("qwen3", tp_size=4, tp_rank=rank,
+                         port=PORT, graph=False), torch.device("cpu"))
+    assert svc._bucket.num_groups == 2
+    result = train(svc, full)
+    torch.save(result, Path(out) / f"rank{rank}.pt")
+    dist.destroy_process_group()
+
+
+def main():
+    full = T.build_full("qwen3", seed=37)
+    full["ft"] = {k: v for k, v in full["ft"].items() if ".o_proj." not in k}
+    ref = T.make_service("qwen3", full["base"], full["ft"],
+                         T.make_meta("qwen3", tp_size=1, tp_rank=0, port=0,
+                                     graph=False), torch.device("cpu"))
+    expected = train(ref, full)
+    checker = T.H.Checker(tol=1e-4)
+    with tempfile.TemporaryDirectory(prefix="qkv_bucket_tp4_") as tmp:
+        path = str(Path(tmp) / "full.pt")
+        torch.save(full, path)
+        ctx = mp.get_context("spawn")
+        procs = [ctx.Process(target=worker, args=(rank, path, tmp)) for rank in range(4)]
+        for proc in procs:
+            proc.start()
+        for proc in procs:
+            proc.join(120)
+            assert proc.exitcode == 0, proc.exitcode
+        ranks = [torch.load(Path(tmp) / f"rank{rank}.pt") for rank in range(4)]
+        for rank, result in enumerate(ranks):
+            checker.check(f"rank {rank} loss trajectory", result["losses"], expected["losses"])
+        for key, param in expected["masters"].items():
+            if key.endswith("A"):
+                for rank, result in enumerate(ranks):
+                    checker.check(f"rank {rank} {key}", result["masters"][key], param)
+            else:
+                checker.check(f"concat {key}", torch.cat([r["masters"][key] for r in ranks]), param)
+        checker.finish()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_backward_pause_resume.py b/tests/test_backward_pause_resume.py
new file mode 100644
index 0000000..74e8e65
--- /dev/null
+++ b/tests/test_backward_pause_resume.py
@@ -0,0 +1,110 @@
+"""Backward resumes during idle without cancelling a newer throttle pause."""
+
+from contextlib import nullcontext
+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from vllm.config.finetune import FinetuneConfig
+from vllm.v1.worker.gpu_model_runner import GPUModelRunner
+
+
+class PauseResumeTest(unittest.TestCase):
+    def make_idle_runner(self, event, relay_mode):
+        coord = Mock(relay_mode=relay_mode)
+        runner = SimpleNamespace(
+            execute_model_state=None,
+            routed_experts_initialized=False,
+            speculative_config=None,
+            parallel_config=SimpleNamespace(distributed_executor_backend="mp"),
+            vllm_config=SimpleNamespace(
+                finetune_config=FinetuneConfig(
+                    fwd_token_throttle_enable=True, fwd_token_throttle=0
+                )
+            ),
+            synchronize_input_prep=nullcontext,
+            _update_states=Mock(),
+            _ft_fill_relay_fields=Mock(),
+            _ft_coordinator=coord,
+            _ft_resume_evt=event,
+            _throttle_held=False,
+        )
+        runner._ft_maybe_resume_backward = lambda c: (
+            GPUModelRunner._ft_maybe_resume_backward(runner, c)
+        )
+        return runner, coord
+
+    def execute_idle(self, runner):
+        output = SimpleNamespace(total_num_scheduled_tokens=0)
+        module = "vllm.v1.worker.gpu_model_runner"
+        with (
+            patch(module + ".has_kv_transfer_group", return_value=False),
+            patch(module + ".has_ec_transfer", return_value=False),
+        ):
+            return GPUModelRunner.execute_model(runner, output)
+
+    def test_idle_step_resumes_completed_ft_forward_without_throttle(self):
+        for relay in (False, True):
+            with self.subTest(relay_mode=relay):
+                event = Mock(query=Mock(return_value=True))
+                runner, coord = self.make_idle_runner(event, relay)
+                self.execute_idle(runner)
+                coord.gpu_resume_backward.assert_called_once_with()
+                self.assertIsNone(runner._ft_resume_evt)
+                # A later idle poll must not release the grant a second time.
+                self.execute_idle(runner)
+                coord.gpu_resume_backward.assert_called_once_with()
+
+    def test_idle_step_retries_event_after_sample_tokens_misses_completion(self):
+        for relay in (False, True):
+            with self.subTest(relay_mode=relay):
+                event = Mock(query=Mock(side_effect=[False, False, True]))
+                runner, coord = self.make_idle_runner(event, relay)
+                # The same event poll used by sample_tokens runs before the
+                # GPU completes. Idle execute_model calls must keep polling.
+                runner._ft_maybe_resume_backward(coord)
+                self.execute_idle(runner)
+                coord.gpu_resume_backward.assert_not_called()
+                self.assertIs(runner._ft_resume_evt, event)
+                self.execute_idle(runner)
+                coord.gpu_resume_backward.assert_called_once_with()
+                self.assertIsNone(runner._ft_resume_evt)
+
+    def test_idle_step_releases_sticky_throttle(self):
+        runner, coord = self.make_idle_runner(None, True)
+        runner._throttle_held = True
+        coord.fwd_throttle_active = True
+        self.execute_idle(runner)
+        coord.gpu_resume_backward.assert_called_once_with()
+        self.assertFalse(runner._throttle_held)
+        self.assertFalse(coord.fwd_throttle_active)
+
+    def test_completed_prefill_keeps_new_throttle_pause(self):
+        runner = SimpleNamespace(
+            _ft_resume_evt=Mock(query=lambda: True), _throttle_held=True
+        )
+        coord = Mock()
+        GPUModelRunner._ft_maybe_resume_backward(runner, coord)
+        coord.gpu_resume_backward.assert_not_called()
+        self.assertIsNone(runner._ft_resume_evt)
+
+    def test_completed_prefill_without_throttle_resumes(self):
+        runner = SimpleNamespace(
+            _ft_resume_evt=Mock(query=lambda: True), _throttle_held=False
+        )
+        coord = Mock()
+        GPUModelRunner._ft_maybe_resume_backward(runner, coord)
+        coord.gpu_resume_backward.assert_called_once_with()
+        self.assertIsNone(runner._ft_resume_evt)
+
+    def test_unfinished_prefill_does_not_resume(self):
+        event = Mock(query=lambda: False)
+        runner = SimpleNamespace(_ft_resume_evt=event, _throttle_held=False)
+        coord = Mock()
+        GPUModelRunner._ft_maybe_resume_backward(runner, coord)
+        coord.gpu_resume_backward.assert_not_called()
+        self.assertIs(runner._ft_resume_evt, event)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_ft_scheduler_idle_throttle.py b/tests/test_ft_scheduler_idle_throttle.py
new file mode 100644
index 0000000..351c041
--- /dev/null
+++ b/tests/test_ft_scheduler_idle_throttle.py
@@ -0,0 +1,103 @@
+"""An expiring RPS gate must not put live training to sleep."""
+
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+from vllm.config.finetune import FinetuneConfig
+from vllm.deltaserve.coordinator import FinetuneCoordinator
+from vllm.deltaserve.ft_scheduler import FinetuneScheduler
+from vllm.v1.core.sched.async_scheduler import AsyncScheduler
+
+
+class IdleThrottleTest(unittest.TestCase):
+    def make_scheduler(self, relay):
+        coord = FinetuneCoordinator(512)
+        coord.relay_mode = relay
+        coord.rps_tracker.note_arrival(10.0)
+        self.check_rate(coord, 10.0)
+        scheduler = object.__new__(FinetuneScheduler)
+        scheduler._coord = coord
+        scheduler._profiling_mode = False
+        scheduler.vllm_config = SimpleNamespace(
+            finetune_config=FinetuneConfig(enable_finetuning=True)
+        )
+        scheduler._ft_injector = SimpleNamespace(
+            store=SimpleNamespace(
+                has_next=lambda: True,
+                current_epoch=0,
+                total_epochs=1,
+                sorted_lengths=[32],
+                has_claimed=lambda: False,
+            )
+        )
+        return scheduler, coord
+
+    def check_rate(self, coord, now):
+        coord.check_rps_throttle(
+            now, close_rps=5, open_rps=2, window_s=0.1, close_time=1
+        )
+
+    def has_idle_work(self, scheduler):
+        # The inference scheduler reports no more requests. This is exactly
+        # when EngineCore otherwise blocks waiting for another client request.
+        with patch.object(AsyncScheduler, "has_requests", return_value=False):
+            return scheduler.has_requests()
+
+    def test_throttle_keeps_engine_alive_until_quiet_window(self):
+        for relay in (False, True):
+            with self.subTest(relay=relay):
+                scheduler, coord = self.make_scheduler(relay)
+                self.assertEqual(coord.next_ft_budget(), 0)
+                self.assertTrue(self.has_idle_work(scheduler))
+                self.assertFalse(getattr(scheduler, "_ft_exhausted_logged", False))
+                # schedule() can now run again after the rate window expires.
+                self.check_rate(coord, 10.2)
+                self.assertFalse(coord.rps_throttle_active)
+                self.assertEqual(coord.next_ft_budget(), 512)
+                self.assertTrue(self.has_idle_work(scheduler))
+
+    def test_backward_done_does_not_sleep_while_rate_gate_is_held(self):
+        for relay in (False, True):
+            with self.subTest(relay=relay):
+                scheduler, coord = self.make_scheduler(relay)
+                coord.pending_backward = True
+                response = {"event": "activations_processed", "n": 512}
+                if relay:
+                    coord.apply_relayed_done(response)
+                else:
+                    coord.backward_process = SimpleNamespace(
+                        poll_response=lambda: response
+                    )
+                    coord.poll_backward()
+                self.assertFalse(coord.pending_backward)
+                self.assertTrue(coord.rps_throttle_active)
+                self.assertEqual(coord.next_ft_budget(), 0)
+                self.assertTrue(self.has_idle_work(scheduler))
+
+    def test_stopped_and_profiling_training_can_sleep(self):
+        scheduler, coord = self.make_scheduler(False)
+        coord.ft_started = False
+        self.assertFalse(self.has_idle_work(scheduler))
+        coord.ft_started = True
+        scheduler._profiling_mode = True
+        self.assertFalse(self.has_idle_work(scheduler))
+        scheduler._profiling_mode = False
+        scheduler.vllm_config.finetune_config.enable_finetuning = False
+        self.assertFalse(self.has_idle_work(scheduler))
+
+    def test_exhausted_data_can_sleep_with_stale_rate_gate(self):
+        scheduler, _ = self.make_scheduler(False)
+        store = scheduler._ft_injector.store
+        store.has_next = lambda: False
+        store.current_epoch = store.total_epochs
+        self.assertFalse(self.has_idle_work(scheduler))
+
+    def test_next_epoch_keeps_rate_gate_polling(self):
+        scheduler, _ = self.make_scheduler(False)
+        scheduler._ft_injector.store.has_next = lambda: False
+        self.assertTrue(self.has_idle_work(scheduler))
+
+
+if __name__ == "__main__":
+    unittest.main()
