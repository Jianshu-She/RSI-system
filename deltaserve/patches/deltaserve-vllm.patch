+async def ft_ingest(raw_request: Request):
+    """[RSI] Append FT samples to the live store while serving. Body:
+    ``{"rows": [{"messages": [...]}, ...]}`` (chat rows, rendered and masked
+    per ``finetune.chat_loss_on`` / ``chat_thinking``) or ``{"text": ...}``
