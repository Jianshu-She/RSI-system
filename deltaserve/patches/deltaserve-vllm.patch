+# Qwen3-32B TP=4 on H200 with 16K context for BOTH inference and FT samples.
+# Derived from serving_config_finetuning_qwen3_32b_tp4_baselines.yaml; the
+# long-context differences:
+#   - model.max_model_len 20480: 16K prompts + room to generate.
+#   - engine.max_num_batched_tokens 16384: an FT sample prefills in ONE step
+#     (invariant 2), so the step budget must hold the longest sample.
+#     engine.long_prefill_token_threshold 2048 keeps INFERENCE prefill chunks
+#     small (FT requests are exempt — see v1/core/sched/scheduler.py).
+#   - finetune.max_saved_finetuning_tokens 16384: buffer holds one 16K sample
+#     (~3.5 MB/token/rank with every save on → ~58 GB/rank).
+#   - finetune.backward_batch_tokens 512: short samples still train in
+#     ~512-token batches; a longer sample is admitted alone into an empty buffer.
+#   - finetune.backward_cuda_graph_max_tokens 512: graphs captured for the
+#     short batches; long backwards run eager (chunked attention, streaming head).
+#   - profile_on_launch off for the first bring-up.
+finetune:
+  enable_finetuning: true
+  start_on_launch: false
+  backward_mps_percentage: 0
+  graph_ft_batches: true
+  graph_ft_max_tokens: 512
+  backward_run_ahead_boundaries: 2
+  finetuning_lora_path: ../adapters/qwen3-32b-qkv-r8-initial
+  data_path: ../long_ft_corpus.txt
+  max_saved_finetuning_tokens: 16384
+  backward_batch_tokens: 512
+  backward_cuda_graph_max_tokens: 512
+  num_epochs: 100
+  learning_rate: 0.0003
+  weight_decay: 0.01
+  gamma: 1.0
+  backward_fp32: false
+  forward_interruptible: true
+  ft_only_admission_grace_ms: 2.0
+  rps_throttle_enable: true
+  rps_throttle_close_rps: 5.0
+  rps_throttle_open_rps: 2.0
+  rps_throttle_window_s: 0.1
+  rps_throttle_close_time: 1.0
+  fwd_token_throttle_enable: true
+  fwd_token_throttle: 0
+  pause_prefill_always: true
+  backward_cuda_graph: true
+  backward_cuda_graph_attn_bn_max: 28
+  backward_cuda_graph_attn_l_max: 64
+  save_attn_qkv: true
+  save_attn_ctx: true
+  save_resid_mid: true
+slo:
+  ttft_slo: 0.3
+  avg_tbt_slo: 0.02
+  max_tbt_slo: 0.05
+  profile_on_launch: false
+  profile_num_repeats: 2
+  ft_tokens_admission_constrain_factor: 0.0
+  match_prefill_workload_factor: 0
+  decode_only_ft_safety_margin: 0.7
+debug:
+  print_weight_hash: false
+  print_activation_hash: false
+  print_scheduler_add: false
+  print_engine_batch_exec: false
+  print_engine_batch_done: false
+  print_engine_req_recv: false
+adapters:
+  lora_path_0: ../adapters/qwen3-32b-qkv-r8-initial
+lora:
+  enable_lora: true
+  max_loras: 2
+  max_lora_rank: 8
+server:
+  host: 127.0.0.1
+  port: 8000
+  api_server_count: 1
+model:
+  model: /mnt/weka/home/jianshu.she/scratch/Qwen3-32B
+  tokenizer_mode: auto
+  trust_remote_code: false
+  dtype: bfloat16
+  max_model_len: 20480
+engine:
+  gpu_memory_utilization: 0.42   # vLLM budget EXCLUDES the ~58 GB 16K activation buffers + backward child (~15 GB)
+  enforce_eager: false
+  disable_log_stats: true
+  seed: 0
+  max_num_batched_tokens: 16384
+  long_prefill_token_threshold: 2048
+parallel:
+  tensor_parallel_size: 4
