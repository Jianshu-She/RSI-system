+# Qwen3-32B TP=4 on H200 with 16K context for BOTH inference and FT samples.
+# Derived from serving_config_finetuning_qwen3_32b_tp4_baselines.yaml; the
+# long-context differences:
+#   - model.max_model_len 20480: 16K prompts + room to generate.
+#   - engine.max_num_batched_tokens 16384: an FT sample prefills in ONE step
+#     (invariant 2), so the step budget must hold the longest sample.
+#     engine.long_prefill_token_threshold 2048 keeps INFERENCE prefill chunks
+#     small (FT requests are exempt — see v1/core/sched/scheduler.py).
+#   - finetune.max_saved_finetuning_tokens 16384: buffer holds one 16K sample
+#     (~3.5 MB/token/rank with every save on → ~58 GB/rank).
+#   - finetune.backward_batch_tokens 512: short samples still train in
+#     ~512-token batches; a longer sample is admitted alone into an empty buffer.
+#   - finetune.backward_cuda_graph_max_tokens 512: graphs captured for the
+#     short batches; long backwards run eager (chunked attention, streaming head).
+#   - profile_on_launch off for the first bring-up.
+finetune:
+  enable_finetuning: true
+  start_on_launch: false
+  backward_mps_percentage: 0
+  graph_ft_batches: true
+  graph_ft_max_tokens: 512
+  backward_run_ahead_boundaries: 2
+  finetuning_lora_path: ../adapters/qwen3-32b-qkv-r8-initial
+  data_path: ../long_ft_corpus.txt
