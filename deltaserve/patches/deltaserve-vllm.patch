+"""The shared pause/release predicate must protect a one-token decode."""
+import unittest
+
+from vllm.config.finetune import FinetuneConfig
+
+
+class ForwardThrottleTest(unittest.TestCase):
+    def test_zero_threshold_protects_single_decode(self):
+        cfg = FinetuneConfig(fwd_token_throttle_enable=True,
+                             fwd_token_throttle=0)
+        self.assertTrue(cfg.should_throttle_backward(1))
+        self.assertTrue(cfg.should_throttle_backward(512))
+        # Both an empty step and pure FT have zero inference tokens: release.
+        self.assertFalse(cfg.should_throttle_backward(0))
+
+    def test_positive_threshold_remains_strict(self):
+        cfg = FinetuneConfig(fwd_token_throttle_enable=True,
+                             fwd_token_throttle=32)
+        self.assertFalse(cfg.should_throttle_backward(32))
+        self.assertTrue(cfg.should_throttle_backward(33))
+
+    def test_disabled_and_negative_threshold(self):
+        cfg = FinetuneConfig(fwd_token_throttle_enable=False,
+                             fwd_token_throttle=0)
+        self.assertFalse(cfg.should_throttle_backward(512))
+        cfg.fwd_token_throttle_enable = True
+        cfg.fwd_token_throttle = -1
+        self.assertFalse(cfg.should_throttle_backward(512))
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_long_context_backward.py b/tests/test_long_context_backward.py
new file mode 100644
index 0000000..52e1eaf
--- /dev/null
+++ b/tests/test_long_context_backward.py
@@ -0,0 +1,157 @@
+"""Long-context backward gates (run with `python`, not pytest).
+
+1. Query-chunked attention forward/backward == the dense path (fp32).
+2. Streaming LM head (online logsumexp) == the dense head (loss + grad).
+3. Coordinator ``batch_tokens``: an empty buffer takes one long sample, a
+   non-empty one only tops up to the batch size.
+4. (GPU) one Qwen3-32B-TP4-shaped layer's attention backward at 16K tokens:
+   peak memory and time, on the chunked path.
+
+    python tests/test_long_context_backward.py
+"""
+
+from __future__ import annotations
+
+import sys
+import time
+
+import torch
+
+from vllm.deltaserve.bwd_services.common import attention as A
+from vllm.deltaserve.bwd_services.common import head as Hd
+from vllm.deltaserve.coordinator import FinetuneCoordinator
+
+DEV = "cuda" if torch.cuda.is_available() else "cpu"
+PASS = FAIL = 0
+
+
+def check(name, got, ref, tol):
+    global PASS, FAIL
+    err = (got.float() - ref.float()).abs().max().item()
+    scale = ref.float().abs().max().item() + 1e-12
+    ok = err / scale <= tol
+    PASS += ok
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}: rel max err {err / scale:.2e}")
+
+
+def cond(name, ok):
+    global PASS, FAIL
+    PASS += bool(ok)
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}")
+
+
+def attn_parity():
+    print("attention: chunked vs dense")
+    torch.manual_seed(0)
+    Hq, Hkv, D = 8, 2, 64
+    seq_lens = [37, 300, 1000, 17]
+    b_start = [sum(seq_lens[:i]) for i in range(len(seq_lens))]
+    n = sum(seq_lens)
+    dims = (Hq, Hkv, D, Hkv * D)
+    qh = torch.randn(n, Hq, D, device=DEV)
+    kh = torch.randn(n, Hkv, D, device=DEV)
+    vh = torch.randn(n, Hkv, D, device=DEV)
+    g = torch.randn(n, Hq, D, device=DEV)
+    big = A.SCORES_BYTES
+    try:
+        A.SCORES_BYTES = 1 << 62                       # dense everywhere
+        ref_ctx = A.attn_forward_core(qh, kh, vh, seq_lens, b_start, dims,
+                                      torch.float32)
+        ref = A.attn_backward_core(qh, kh, vh, g, seq_lens, b_start, dims)
+        for budget in (Hq * 1000 * 4 * 100, Hq * 1000 * 4 * 16, 4096):
+            A.SCORES_BYTES = budget                    # chunk the long ones
+            cs = [A._q_chunk(Hq, ln) for ln in seq_lens]
+            ctx = A.attn_forward_core(qh, kh, vh, seq_lens, b_start, dims,
+                                      torch.float32)
+            got = A.attn_backward_core(qh, kh, vh, g, seq_lens, b_start, dims)
+            cond(f"budget={budget} chunks={cs} takes the chunked path",
+                 any(c < ln for c, ln in zip(cs, seq_lens)))
+            check(f"budget={budget} ctx", ctx, ref_ctx, 1e-5)
+            for nm, a, b in zip(("dq", "dk", "dv"), got, ref):
+                check(f"budget={budget} {nm}", a, b, 1e-5)
+    finally:
+        A.SCORES_BYTES = big
+
+
+def head_parity():
+    print("head: streaming vs dense")
+    torch.manual_seed(1)
+    D, vocab, vpad = 64, 40000, 40064               # > 2 vocab chunks + padding
+    seq_lens = [50, 3, 1, 200]
+    b_start = [sum(seq_lens[:i]) for i in range(len(seq_lens))]
+    n = sum(seq_lens)
+    final_in = torch.randn(n, D, device=DEV, dtype=torch.bfloat16)
+    lm_w = (torch.randn(vpad, D, device=DEV) * 0.05).to(torch.bfloat16)
+    norm_w = torch.rand(D, device=DEV) + 0.5
+    ids = torch.randint(0, vocab, (n,), device=DEV)
+    ids[5] = vocab - 1                               # target in the last chunk
+    ids[6] = 0
+    big = Hd.LOGITS_BYTES
+    try:
+        Hd.LOGITS_BYTES = 1 << 62
+        l_ref, nv_ref, g_ref = Hd.head_backward(final_in, lm_w, norm_w, 1e-6, ids,
+                                                seq_lens, b_start, vocab)
+        Hd.LOGITS_BYTES = 0
+        l, nv, g = Hd.head_backward(final_in, lm_w, norm_w, 1e-6, ids,
+                                    seq_lens, b_start, vocab)
+    finally:
+        Hd.LOGITS_BYTES = big
+    cond(f"n_valid {nv} == {nv_ref}", nv == nv_ref)
+    cond(f"loss {l:.6f} == {l_ref:.6f}", abs(l - l_ref) <= 1e-5 * abs(l_ref))
+    check("grad_final_in", g, g_ref, 1e-5)
+
+
+def coordinator_batching():
+    print("coordinator: batch_tokens")
+    c = FinetuneCoordinator(capacity=16384)
+    cond("default batch_tokens == capacity", c.batch_tokens == 16384)
+    c.batch_tokens = 512
+    cond("empty buffer offers the full capacity", c.space_remaining() == 16384)
+    c.fill_count = 300
+    cond("non-empty buffer tops up to batch_tokens", c.space_remaining() == 212)
+    c.fill_count = 10000
+    cond("a long sample alone leaves no space", c.space_remaining() == 0)
+    c.fill_count, c.reserved_fill = 0, 200
+    cond("reservations count as used", c.space_remaining() == 312)
+    c2 = FinetuneCoordinator(capacity=512)
+    c2.fill_count = 100
+    cond("batch_tokens == capacity keeps the original arithmetic",
+         c2.space_remaining() == 412)
+
+
+def long_attention_cost():
+    if DEV != "cuda":
+        print("long attention: skipped (no GPU)")
+        return
+    print("long attention: Qwen3-32B TP=4 shard (Hq=16, Hkv=2, Hd=128), L=16384")
+    torch.manual_seed(2)
+    Hq, Hkv, D, L = 16, 2, 128, 16384
+    dims = (Hq, Hkv, D, Hkv * D)
+    qh = torch.randn(L, Hq, D, device=DEV, dtype=torch.bfloat16)
+    kh = torch.randn(L, Hkv, D, device=DEV, dtype=torch.bfloat16)
+    vh = torch.randn(L, Hkv, D, device=DEV, dtype=torch.bfloat16)
+    g = torch.randn(L, Hq, D, device=DEV, dtype=torch.bfloat16)
+    torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+    base = torch.cuda.memory_allocated()
+    t0 = time.perf_counter()
+    out = A.attn_backward_core(qh, kh, vh, g, [L], [0], dims, cdt=torch.bfloat16)
+    torch.cuda.synchronize()
+    dt = time.perf_counter() - t0
+    peak = (torch.cuda.max_memory_allocated() - base) / 2**30
+    dense = 4 * Hq * L * L * 4 / 2**30
+    print(f"  chunk={A._q_chunk(Hq, L)} rows, {dt * 1e3:.0f} ms/layer, "
+          f"peak +{peak:.2f} GiB (dense path would need ~{dense:.0f} GiB)")
+    cond("finite grads", all(torch.isfinite(t).all().item() for t in out))
+    cond("peak memory < 4 GiB", peak < 4)
+
+
+if __name__ == "__main__":
+    attn_parity()
+    head_parity()
+    coordinator_batching()
+    long_attention_cost()
+    print(f"\n{PASS} passed, {FAIL} failed")
+    sys.exit(1 if FAIL else 0)
diff --git a/tests/test_rope_yarn.py b/tests/test_rope_yarn.py
new file mode 100644
index 0000000..1dc7994
--- /dev/null
+++ b/tests/test_rope_yarn.py
@@ -0,0 +1,115 @@
+"""Backward RoPE with YaRN == vLLM's YaRNScalingRotaryEmbedding (run with `python`).
+
+RSI-system serves Qwen3-32B with YaRN x4 (131072 ctx). YaRN changes the rotary
+frequencies at EVERY position and scales cos/sin by mscale, so the backward's
+RoPE remat must reproduce it exactly or the LoRA gradients are wrong.
+
+    python tests/test_rope_yarn.py [--yarn-config DIR]
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+
+import torch
+from transformers import AutoConfig
+
+from vllm.deltaserve.bwd_services.common.ops import apply_rope, rope_backward, rope_cos_sin
+from vllm.deltaserve.ft_meta import rope_scaling_of
+from vllm.model_executor.layers.rotary_embedding.yarn_scaling_rope import (
+    YaRNScalingRotaryEmbedding,
+)
+
+PASS = FAIL = 0
+
+
+def cond(name, ok, detail=""):
+    global PASS, FAIL
+    PASS += bool(ok)
+    FAIL += not ok
+    print(f"  [{'ok' if ok else 'FAIL'}] {name}{(' — ' + detail) if detail else ''}")
+
+
+def _vllm_yarn_cache(hd, orig, theta, factor):
+    """vLLM's own YaRN cos/sin cache, via its methods on a bare instance (the
+    CustomOp constructor needs a device-bearing vLLM config; the math does not)."""
+    from vllm.model_executor.layers.rotary_embedding.common import yarn_get_mscale
+    ref = object.__new__(YaRNScalingRotaryEmbedding)
+    ref.head_size = ref.rotary_dim = hd
+    ref.max_position_embeddings = orig
+    ref.base = theta
+    ref.scaling_factor = factor
+    ref.extrapolation_factor = ref.attn_factor = 1
+    ref.beta_fast, ref.beta_slow, ref.truncate = 32, 1, True
+    ref.mscale = float(yarn_get_mscale(factor))
+    return ref._compute_cos_sin_cache()
+
+
+def against_vllm(theta=1e6, hd=128, factor=4.0, orig=32768):
+    print(f"cos/sin + rotation vs vLLM YaRN (theta={theta:g}, head_dim={hd}, x{factor:g})")
+    cache_all = _vllm_yarn_cache(hd, orig, theta, factor)
+    sc = {"rope_type": "yarn", "factor": factor, "original_max_position_embeddings": orig}
+    pos = torch.tensor([0, 1, 7, 513, 4095, 32767, 40000, 131071])
+    cache = cache_all[pos].float()
+    cos_r, sin_r = cache[:, : hd // 2], cache[:, hd // 2:]
+    cos, sin = rope_cos_sin(pos, hd, theta, sc)
+    err = max((cos - cos_r).abs().max().item(), (sin - sin_r).abs().max().item())
+    cond("cos/sin == vLLM YaRN cache (incl. mscale)", err < 1e-5, f"max abs err {err:.1e}")
+    plain_c, _ = rope_cos_sin(pos, hd, theta)
+    cond("YaRN differs from plain RoPE (so the fix matters)",
+         (plain_c - cos).abs().max().item() > 1e-2)
+
+    torch.manual_seed(0)
+    n, H = len(pos), 4
+    q = torch.randn(n, H, hd)
+    # NeoX rotation with vLLM's cache, written out independently
+    c, s_ = cos_r[:, None, :], sin_r[:, None, :]
+    x1, x2 = q[..., : hd // 2], q[..., hd // 2:]
+    q_r = torch.cat([x1 * c - x2 * s_, x2 * c + x1 * s_], dim=-1)
+    q_o = apply_rope(q, cos, sin)
+    err = (q_o - q_r).abs().max().item() / q_r.abs().max().item()
+    cond("apply_rope == NeoX rotation with vLLM's cache", err < 1e-5, f"rel err {err:.1e}")
+    g = torch.randn(n, H, hd)
+    lhs = (g * apply_rope(q, cos, sin)).sum()
+    rhs = (rope_backward(g, cos, sin) * q).sum()
+    cond("rope_backward is the adjoint under mscale", abs(lhs - rhs) / abs(lhs) < 1e-5)
+
+
+def config_parsing(yarn_dir):
+    print("rope_scaling_of")
+    class C:  # transformers 5 / vLLM-normalized form
+        rope_parameters = {"rope_theta": 1e6, "rope_type": "yarn", "factor": 4.0,
+                           "original_max_position_embeddings": 32768}
+    got = rope_scaling_of(C())
+    cond("rope_parameters (yarn) parsed", got == {"rope_type": "yarn", "factor": 4.0,
+                                                  "original_max_position_embeddings": 32768}, str(got))
+    class P:
+        rope_parameters = {"rope_theta": 1e6, "rope_type": "default"}
+    cond("plain RoPE → None", rope_scaling_of(P()) is None)
+    class L:
+        rope_parameters = {"rope_theta": 5e5, "rope_type": "llama3", "factor": 8.0}
+    try:
+        rope_scaling_of(L())
+        cond("unsupported scaling raises", False)
+    except NotImplementedError:
+        cond("unsupported scaling raises", True)
+    if yarn_dir:
+        try:
+            got = rope_scaling_of(AutoConfig.from_pretrained(yarn_dir))
+            cond(f"RSI-system YaRN model config parsed ({yarn_dir.rsplit('/', 1)[-1]})",
+                 got is not None and got["factor"] == 4.0
+                 and got["original_max_position_embeddings"] == 32768, str(got))
+        except OSError as e:
+            print(f"  (skip real config: {e})")
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--yarn-config",
+                    default="/mnt/weka/home/jianshu.she/RSI-system/benchmark/ACE/models/Qwen3-32B-yarn131k")
+    a = ap.parse_args()
+    against_vllm()
+    config_parsing(a.yarn_config)
+    print(f"\n{PASS} passed, {FAIL} failed")
+    sys.exit(1 if FAIL else 0)
diff --git a/tests/test_rps_throttle_admission.py b/tests/test_rps_throttle_admission.py
