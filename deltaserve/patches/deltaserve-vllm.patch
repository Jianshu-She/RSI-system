+set -u
+GPU=$1; PORT=$2; TASK=$3; TAG=$4; ADAPTER=${5:-}
+ACE=/mnt/weka/home/jianshu.she/RSI-system/benchmark/ACE
+VLLM=/mnt/weka/home/jianshu.she/RSI-system/benchmark/reasoningbank/envs/vllm/bin/vllm
